# ---------- HetrixTools ----------
# Required if any component uses a monitor. Create at HetrixTools > API Keys.
# Read-only access to uptime monitors and uptime reports is enough.
HETRIX_API_KEY=

# ---------- Incidents (Neon Postgres) ----------
# Without this the page works, but incidents and /admin are turned off.
DATABASE_URL=

# ---------- Admin sign-in (Discord) ----------
# From your Discord application (discord.com/developers > OAuth2).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Random string, at least 32 characters. Changing it signs everyone out.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Who may sign in. Use either or both:
#   comma-separated Discord user IDs
ADMIN_DISCORD_IDS=
#   or anyone holding one of these roles in this Discord server
DISCORD_GUILD_ID=
DISCORD_ADMIN_ROLE_IDS=
