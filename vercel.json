{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm test && npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/incidents/:id",
      "destination": "/incident/index.html"
    },
    {
      "source": "/feed.xml",
      "destination": "/api/feed"
    }
  ]
}
