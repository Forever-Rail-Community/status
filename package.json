{
  "name": "forever-rail-status",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "dev": "npm run build && vercel dev",
    "monitors": "node --env-file=.env scripts/list-monitors.js",
    "db:migrate": "node --env-file=.env scripts/migrate.js",
    "check-metrics": "node --env-file=.env scripts/check-metrics.js",
    "test": "node --test test/*.test.js",
    "test:db": "node --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1"
  },
  "devDependencies": {
    "pg": "^8.23.1"
  }
}
